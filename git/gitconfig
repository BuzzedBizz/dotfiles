# This isn't a symlink because my name and email get put in this file
# If it were then it would get put in here on setup
[alias]
    ac = !git add -A && git commit
    a = add
    s = status
    d = "!nvim -c DiffviewOpen"
    mergetool = "!nvim -c DiffviewOpen"
    uncommit = reset --soft "HEAD^"
    unstage = reset
[color]
    filemode = false
    diff = auto
    status = auto
    branch = auto
    pager = true
[core]
    excludesfile = ~/.gitignore_global
    editor = nvim
    autocrlf = input
[push]
    autoSetupRemote = true
[diff]
    tool = nvimdiff
    guitool = nvimdiff
[difftool]
    prompt = false
[difftool "nvimdiff"]
    path = nvim
[merge]
    tool = nvimdiff
    conflictstyle = diff3
[mergetool]
    prompt = false
    keepBackup = false
    trustExitCode = false
[mergetool "nvimdiff"]
    path = nvim
    layout = LOCAL,MERGED,REMOTE
