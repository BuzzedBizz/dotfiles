{{- /* Machine-local chezmoi config. Generated by `chezmoi init`, never commited. */ -}}

{{/* The defaults are what `--promptDefaults` returs headless; a prompt*Once
     with no default opens /dev/tty even under that flag, and fails. */ -}}
{{- $name  := promptStringOnce . "name"  "Full name for git commits"  "Chad Bissett" -}}
{{- $email := promptStringOnce . "email" "Email address for git commits" "chadbissett@live.com" -}}

{{/* The working tree, not home/: a later bare `chezmoi apply` has to re-read
     .chezmoiroot rather than bypass it. */ -}}
sourceDir = {{ .chezmoi.workingTree | quote }}

[edit]
    # make `chezmoi edit` feel like editing the real file.
    watch = true

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}

    isWSL = {{ contains "microsoft" (lower .chezmoi.kernel.osrelease) }}
