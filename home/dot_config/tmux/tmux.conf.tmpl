{{- $tpmDir := joinPath .chezmoi.homeDir ".config" "tmux" "plugins" "tpm" -}}
{{- $pluginDir := joinPath (includeTemplate "xdg-root" .) .xdg.dataHome "tmux" -}}
# tpm is cloned by .chezmoiscripts/run_onchange_after_20-plugin-managers.sh.
#
# Paths are rendered by chezmoi rather than written as ${XDG_*}: a tmux server
# started from a display manager or a bare `ssh host tmux` has neither
# variable set, collapsing the expansion to /tmux/plugins/tpm/tpm.

# enable mouse input
set-option -gq mouse on

# tmux-256color is the correct TERM to advertise inside tmux, but its terminfo
# entry is missing on older ncurses (some RHEL boxes), so fall back.
if-shell 'infocmp tmux-256color >/dev/null 2>&1' \
    'set -g default-terminal "tmux-256color"' \
    'set -g default-terminal "xtrem-256color"'
set -as terminal-features ",*256col*:Tc"

# Fixes garbled rgb control characters in windows terminal
set -g escape-time 50

# Vim bindings for everything
set-window-option -g mode-keys vi
bind-key -T copy-mode-vi v send -X begin-selection
bind-key -T copy-mode-vi V send -X select-line

# Yanking behaviour
bind-key -T copy-mode-vi y send -X copy-pipe 'xclip -in -selection clipboard'
unbind -T copy-mode-vi MouseDragEnd1Pane
set -g @yank_action 'copy-pipe'

# Colorscheme
set -g @tmux_power_theme 'gold'

# Plugins
set-environment -g TMUX_PLUGIN_MANAGER_PATH "{{ $pluginDir }}"

# Not tpm itself: listing it here makes tpm install a second copy of itself
# into TMUX_PLUGIN_MANAGER_PATH
set -g @plugin 'tmux-plugins/tmux-sensible' # Sensible defaults
set -g @plugin 'tmux-plugins/tmux-yank' # yank to system clipboard
set -g @plugin 'tmux-plugins/tmux-resurrect' # Save and restore tmux environment across system restarts
set -g @plugin 'tmux-plugins/tmux-continuum' # automatic restore and continuous saving of tmux env
set -g @plugin 'tmux-plugins/tmux-prefix-highlight' # Highlight when prefix is active
set -g @plugin 'wfxr/tmux-power' # Powerline style statusline

# Otherwise continuum saves every 15 minutes and never restores any of it.
set -g @continuum-restore 'on'

# Only on a new machin. Afterwards: prefix + I to install a newly added
# plugin, prefix + alt + u to update
if-shell 'test -z "$(ls -A "${{ $pluginDir }}" 2>/dev/null)"' \
    'run-shell "{{ $tpmDir }}/bin/install_plugins"'

# Running this after we install causes newly installed plugins to install
# on first load
run-shell "{{ $tpmDir }}/tpm"

